{
  "name": "@almadar/evaluator",
  "version": "2.36.0",
  "description": "S-expression evaluator for Almadar",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./operators": {
      "types": "./dist/operators/index.d.ts",
      "import": "./dist/operators/index.js",
      "require": "./dist/operators/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@almadar/core": "^10.35.0",
    "@almadar/std": "^16.145.0"
  },
  "devDependencies": {
    "@almadar/eslint-plugin": "^2.15.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/parser": "8.56.0",
    "eslint": "10.0.0",
    "tsup": "^8.0.0",
    "vitest": "^1.4.0",
    "turbo": "^2.8.17",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/almadar-io/almadar-evaluator.git",
    "directory": "docs/packages/evaluator"
  },
  "license": "BSL-1.1",
  "keywords": [
    "almadar",
    "evaluator",
    "s-expression",
    "sexpr"
  ],
  "homepage": "https://github.com/almadar-io/almadar#readme",
  "packageManager": "pnpm@10.30.3"
}
